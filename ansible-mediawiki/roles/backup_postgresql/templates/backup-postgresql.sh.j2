#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

LOCAL_ROOT="{{ backup_postgresql_local_root }}"
PENDING_DIR="${LOCAL_ROOT}/pending"
SENT_DIR="${LOCAL_ROOT}/sent"
WORK_DIR="$(mktemp -d "${LOCAL_ROOT}/work.XXXXXX")"
BACKUP_HOST="{{ backup_storage_host }}"
BACKUP_USER="{{ backup_storage_user }}"
BACKUP_PORT="{{ backup_storage_port }}"
REMOTE_DIR="{{ backup_postgresql_remote_dir }}"
SSH_KEY="{{ backup_ssh_private_key_path }}"
KNOWN_HOSTS="{{ backup_ssh_known_hosts_path }}"
DATABASE_NAME="{{ mediawiki_db_name }}"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
ARCHIVE_NAME="postgresql-{{ inventory_hostname }}-${TIMESTAMP}.tar.gz"

cleanup() { rm -rf -- "${WORK_DIR}"; }
trap cleanup EXIT

# The script runs as root; PostgreSQL's local peer authentication is used via runuser.
runuser -u postgres -- /usr/bin/pg_dump --format=custom --dbname="${DATABASE_NAME}" > "${WORK_DIR}/database.dump"
runuser -u postgres -- /usr/bin/pg_dumpall --globals-only > "${WORK_DIR}/globals.sql"

tar -czf "${WORK_DIR}/${ARCHIVE_NAME}" -C "${WORK_DIR}" database.dump globals.sql
mv -- "${WORK_DIR}/${ARCHIVE_NAME}" "${PENDING_DIR}/${ARCHIVE_NAME}.pending"

# Retry previously failed transfers before finishing this run.
shopt -s nullglob
for archive in "${PENDING_DIR}"/*.pending; do
    filename="$(basename "${archive%.pending}")"
    scp -P "${BACKUP_PORT}" \
        -i "${SSH_KEY}" \
        -o BatchMode=yes \
        -o StrictHostKeyChecking=yes \
        -o UserKnownHostsFile="${KNOWN_HOSTS}" \
        "${archive}" \
        "${BACKUP_USER}@${BACKUP_HOST}:${REMOTE_DIR}/${filename}.uploading"

    ssh -p "${BACKUP_PORT}" \
        -i "${SSH_KEY}" \
        -o BatchMode=yes \
        -o StrictHostKeyChecking=yes \
        -o UserKnownHostsFile="${KNOWN_HOSTS}" \
        "${BACKUP_USER}@${BACKUP_HOST}" \
        "mv -- '${REMOTE_DIR}/${filename}.uploading' '${REMOTE_DIR}/${filename}'"

    mv -- "${archive}" "${SENT_DIR}/${filename}"
done
