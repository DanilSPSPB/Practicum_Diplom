upstream backend {
{% for host in groups['web_servers'] %}
    server {{ hostvars[host]['ansible_host'] }}:{{ web_nginx_port }} max_fails=3 fail_timeout=30s;
{% endfor %}
}

server {
    listen {{ nginx_balancer_listen_port }} default_server;
    server_name _;

    client_max_body_size {{ nginx_balancer_client_max_body_size }};

    location / {
        proxy_pass http://backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout {{ nginx_balancer_proxy_timeout }}s;
        proxy_send_timeout {{ nginx_balancer_proxy_timeout }}s;
    }
}
